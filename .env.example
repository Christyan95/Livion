# ============================================================================
# LIVION PWA — VARIÁVEIS DE AMBIENTE (.env.local)
# ============================================================================

# Supabase (Público / Browser & SSR)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica

# Supabase Service Role (Uso exclusivo em rotas de servidor / Cron Job)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-secreta

# Segredo de Autenticação do Vercel Cron Job (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# URL base da aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

